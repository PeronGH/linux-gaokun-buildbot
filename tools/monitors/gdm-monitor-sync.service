[Unit]
Description=Sync the gaokun3 panel layout to GDM on first boot
After=gdm.service
Wants=gdm.service
ConditionPathExists=/usr/local/share/gaokun/monitors.xml
ConditionPathExists=!/var/lib/.gaokun-monitors-synced

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gdm-monitor-sync
RemainAfterExit=yes
TimeoutStartSec=70

[Install]
WantedBy=graphical.target
