#!/bin/sh
set -eu

# shellcheck disable=SC1007  # `CDPATH=` is a deliberate one-shot prefix for cd
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for candidate in \
  "$SCRIPT_DIR/tune.py" \
  "/usr/local/lib/gaokun-touchscreen-tuner/tune.py"
do
  if [ -f "$candidate" ]; then
    exec python3 "$candidate" "$@"
  fi
done

echo "touchscreen-tune: tune.py not found" >&2
exit 1
