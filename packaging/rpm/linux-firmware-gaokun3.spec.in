%global debug_package %{nil}
%global _debugsource_packages 0

Name:           linux-firmware-gaokun3
Version:        @FW_VERSION@
Release:        1%{?dist}
Summary:        Model-specific firmware for gaokun3
License:        Redistributable, no modification permitted
BuildArch:      noarch
Source0:        @SOURCE_NAME@
# The generic WCN6855, QCA Bluetooth and Adreno firmware this device also needs
# comes from Fedora, which ships it unchanged or newer. This package adds only
# what Fedora has no copy of.
Requires:       atheros-firmware
Requires:       qcom-firmware

%description
Model-specific firmware for the Huawei MateBook E Go 2023 (gaokun3): the DSP,
display and topology files that Fedora's linux-firmware packages do not carry.

%prep
%setup -q -c -T
tar -xzf %{SOURCE0}

%build

%install
mkdir -p %{buildroot}
cp -a usr %{buildroot}/

%files
# qcom-firmware owns everything above these; the model directory and the
# topology name the sound card asks for are ours.
/usr/lib/firmware/qcom/sc8280xp/HUAWEI
/usr/lib/firmware/qcom/sc8280xp/SC8280XP-HUAWEI-GAOKUN3-tplg.bin

%changelog
* Sat Mar 28 2026 cool <bilibili@att.net> - @FW_VERSION@-1
- Build gaokun3 firmware RPM
