%global debug_package %{nil}
%global _debugsource_packages 0

Name:           @PKG_NAME@
Version:        @KREL_VERSION@
Release:        1%{?dist}
Summary:        Kernel image, DTB, config, and System.map for the gaokun3 kernel
License:        GPL-2.0-only
BuildArch:      aarch64
Source0:        @SOURCE_NAME@
Requires(posttrans): dracut
Requires(posttrans): systemd
Requires(preun): systemd

%description
Kernel image, boot DTB copy, config, and System.map for the gaokun3 kernel @KREL@.

%prep
%setup -q -c -T
tar -xzf %{SOURCE0}

%build

%install
mkdir -p %{buildroot}
cp -a boot %{buildroot}/
cp -a usr %{buildroot}/

%posttrans
if [ "$1" -ge 1 ] && command -v kernel-install >/dev/null 2>&1; then
    temp_conf_root="$(mktemp -d)"
    cleanup() {
        rm -rf "$temp_conf_root"
    }
    trap cleanup EXIT

    if [ -s /etc/kernel/cmdline ]; then
        cmdline="$(tr -s '[:space:]' ' ' </etc/kernel/cmdline)"
    else
        cmdline="$(tr ' ' '\n' </proc/cmdline | grep -ve '^BOOT_IMAGE=' -e '^initrd=' | tr '\n' ' ')"
    fi
    cmdline="${cmdline%" "}"

    printf 'layout=bls\n' > "$temp_conf_root/install.conf"
    printf '%s\n' "$cmdline" > "$temp_conf_root/cmdline"
    printf 'qcom/@DTB_FILE@\n' > "$temp_conf_root/devicetree"

    install -d /etc/kernel/install.d
    ln -sf /dev/null /etc/kernel/install.d/51-dracut-rescue.install
    kernel-install --entry-token=os-id remove 0-rescue || :
    rm -rf /boot/*0-rescue* \
           /boot/efi/*/0-rescue \
           /boot/efi/loader/entries/*-0-rescue.conf

    # No dracut run here: kernel-install's 50-dracut.install builds the initrd
    # into its own staging area and installs that. It only reuses an existing
    # image if one is named "initrd" next to the kernel, which dracut's own
    # /boot/initramfs-<kver>.img is not, so building one first is work thrown
    # away on every install.
    kernel-install --entry-token=os-id remove @KREL@ || :
    KERNEL_INSTALL_CONF_ROOT="$temp_conf_root" \
        kernel-install --make-entry-directory=yes --entry-token=os-id add \
        @KREL@ /boot/vmlinuz-@KREL@ ||
        echo "warning: kernel-install failed for @KREL@, it has no boot entry" >&2

    # As on stock Fedora, installing a kernel makes it the one that boots.
    # Only the standard kernel claims the default; EL2 is opted into from the
    # boot menu, so it must never take it.
    if [ "@IS_DEFAULT_KERNEL@" = "1" ] && [ -f /boot/efi/loader/loader.conf ]; then
        sed -i "s|^default .*|default $(. /etc/os-release; echo "$ID")-@KREL@.conf|" \
            /boot/efi/loader/loader.conf
    fi
fi

%preun
if [ "$1" -eq 0 ] && command -v kernel-install >/dev/null 2>&1; then
    kernel-install --entry-token=os-id remove @KREL@ || :
fi

%files
/boot/vmlinuz-@KREL@
/boot/System.map-@KREL@
/boot/config-@KREL@
/boot/dtb-@KREL@/qcom/@DTB_FILE@
/usr/lib/dracut/dracut.conf.d/90-gaokun3-@KREL@.conf

%changelog
* Sat Mar 28 2026 cool <bilibili@att.net> - @KREL_VERSION@-1
- Build gaokun3 kernel boot RPM
