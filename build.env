# What this tree is built against. Neither is a per-run choice: patches/ applies
# with git am to exactly this kernel tag, and the package set, comps groups and
# systemd presets the image relies on are those of this Fedora release. Bump
# either one in the same commit as the patch refresh or package change it needs.
KERNEL_TAG=v7.2-rc2
FEDORA_RELEASE=44
